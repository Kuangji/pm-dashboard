  "sql": [
    "SELECT id,utm_content,platform_id,channel_id,video_url,video_origin_url,video_type,flag_video,status,data_source,custom_views,video_publish_time,create_time FROM video_monitor_task WHERE platform_id=%s AND flag_delete=0 AND create_time >= %s AND create_time < %s ORDER BY id DESC LIMIT 100",
    "daily: SELECT task_id,monitor_date,monitor_time,video_total_views FROM video_monitor_changes_daily_mv WHERE task_id IN(sample) AND monitor_date >= start AND monitor_date < end ORDER BY task_id,monitor_date",
    "raw: SELECT task_id,monitor_date,monitor_time,video_total_views FROM video_monitor_changes_part WHERE task_id IN(sample) AND monitor_time >= start_ms AND monitor_time < end_ms ORDER BY task_id,monitor_time LIMIT 150000"
  ],
